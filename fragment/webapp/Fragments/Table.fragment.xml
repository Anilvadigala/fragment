<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="productDialog" title="Product List" >
        
            <Table id="productTable" items="{Products>/results}">
                <columns>
                    <Column>
                        <Text text="Product ID" />
                    </Column>
                    <Column>
                        <Text text="Name" />
                    </Column>
                    <Column>
                        <Text text="Quantity" />
                    </Column>
                    <Column>
                        <Text text="Price" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <cells>
                            <Text text="{Products>ProductID}" />
                            <Text text="{Products>ProductName}" />
                            <Text text="{Products>QuantityPerUnit}" />
                            <Text text="{Products>UnitPrice}" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        
        <beginButton>
            <Button text="Close" press="onCloseDialog" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
